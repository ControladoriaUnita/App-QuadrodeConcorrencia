# ---------------------------------------------------------------
# Client-side (expostas no bundle — protegidas por RLS)
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# Server-side (Vercel Functions) — NUNCA prefixar com VITE_
# ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# memory  -> repositórios em memória + MockERPProvider (desenvolvimento/demonstração)
# supabase -> repositórios Supabase (produção)
DATA_SOURCE=memory

# mock | uau | senior
ERP_PROVIDER=mock
ERP_BASE_URL=
ERP_API_KEY=
