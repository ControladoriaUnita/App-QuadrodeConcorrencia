# ---------------------------------------------------------------
# Client-side (expostas no bundle — protegidas por RLS)
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# Server-side (Vercel Functions) — NUNCA prefixar com VITE_
# ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# memory  -> repositórios em memória + MockERPProvider (desenvolvimento/demonstração)
# supabase -> repositórios Supabase (produção)
DATA_SOURCE=memory

# mock | uau | senior (senior ainda não implementado)
ERP_PROVIDER=mock

# UAU (Globaltec/Senior) — só servidor; obrigatórias com ERP_PROVIDER=uau. Sem aspas.
UAU_BASE_URL=
UAU_INTEGRATION_TOKEN=
UAU_LOGIN=
UAU_PASSWORD=

# Planilha de orçamentos no SharePoint (aba BD_Orcamentos), lida pelo Microsoft Graph — só servidor.
# App registrado no Entra ID com permissão de aplicativo Sites.Read.All (consentimento do administrador).
# Na Vercel, a credencial federada dispensa o segredo. Sem credenciais: DATA_SOURCE=memory usa
# orçamentos de exemplo; DATA_SOURCE=supabase dá erro listando o que falta.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Opcionais (padrão: planilha de orçamentos da Unità)
BUDGET_SHEET_DRIVE_ID=b!S3La9JidLE6c3ZTf28lb-loVt7u-9xdEoIsaVk0BY_mFzM2JIEI7SoDCfFHuzgqQ
BUDGET_SHEET_ITEM_ID=01UQIHIUQQC7IHA3D5WFHKTF6TMWDHIWVI
BUDGET_SHEET_NAME=BD_Orcamentos
